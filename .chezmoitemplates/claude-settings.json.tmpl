{{- /*
  Keys chezmoi owns in ~/.claude/settings.json; these override the live file
  on every apply, except hook groups, which are added next to the live ones.
  Preferences Claude Code edits itself (/model, /config) go in
  claude-settings-defaults.json.tmpl instead, so the live value wins.
  Work-only keys live in dotfiles-work/claude/settings.json.
*/ -}}
{
  "attribution": { "commit": "", "pr": "" },
  "enabledPlugins": { "ruby-lsp@claude-plugins-official": true },
  "hooks": {
    "SessionStart": [{ "hooks": [
      { "type": "command", "command": "~/.config/tmux/scripts/claude-sessions.sh tag" },
      { "type": "command", "command": "~/.config/tmux/scripts/claude-state.sh idle" }
    ] }],
    "SessionEnd": [{ "hooks": [
      { "type": "command", "command": "~/.config/tmux/scripts/claude-sessions.sh untag" },
      { "type": "command", "command": "~/.config/tmux/scripts/claude-state.sh end" }
    ] }],
    "UserPromptSubmit": [{ "hooks": [
      { "type": "command", "command": "~/.config/tmux/scripts/claude-state.sh working" }
    ] }],
    "PostToolUse": [{ "hooks": [
      { "type": "command", "command": "~/.config/tmux/scripts/claude-state.sh working" }
    ] }],
    "PreToolUse": [{ "matcher": "AskUserQuestion", "hooks": [
      { "type": "command", "command": "~/.config/tmux/scripts/claude-state.sh waiting" }
    ] }],
    "Notification": [{ "matcher": "permission_prompt|elicitation_dialog", "hooks": [
      { "type": "command", "command": "~/.config/tmux/scripts/claude-state.sh waiting" }
    ] }],
    "Stop": [{ "hooks": [
      { "type": "command", "command": "~/.config/tmux/scripts/claude-state.sh done" }
    ] }],
    "StopFailure": [{ "hooks": [
      { "type": "command", "command": "~/.config/tmux/scripts/claude-state.sh error" }
    ] }]
  },
  "permissions": { "defaultMode": "auto" },
  "skipAutoPermissionPrompt": true,
  "statusLine": { "type": "command", "command": "bash \"$HOME/.claude/statusline-command.sh\"" }
}
