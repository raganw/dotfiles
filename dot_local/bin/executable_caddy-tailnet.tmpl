{{- if and (not .is_work) (hasKey .tailnet.hosts .chezmoi.hostname) -}}
#!/bin/bash
# Runs Caddy for this machine's tailnet services. Started by launchd
# (com.spiffywidgets.caddy-tailnet, KeepAlive). Generated by chezmoi.
#
# The Cloudflare token for the DNS-01 challenge comes from the Keychain at
# start, so it's never in a file: not in the Caddyfile, not in the plist.
# The Keychain, not 1Password, because this starts unattended at login.
# Caddy binds to 127.0.0.1:{{ .tailnet.proxyPort }} only; Tailscale forwards the tailnet
# address's port 443 to it (see the Caddyfile).
set -euo pipefail
CADDY=$HOME/.local/bin/caddy
SERVICE={{ .tailnet.tokenService | quote }}

[[ -x $CADDY ]] || { echo "caddy-tailnet: $CADDY missing (chezmoi apply installs it)" >&2; exit 78; }
token=$(security find-generic-password -s "$SERVICE" -w 2>/dev/null) || {
  echo "caddy-tailnet: no Cloudflare token in the Keychain; add it with:" >&2
  echo "  security add-generic-password -s $SERVICE -a \"\$USER\" -w" >&2
  exit 78
}

export CLOUDFLARE_API_TOKEN=$token
unset token
echo "caddy-tailnet: $(date '+%F %T') starting on 127.0.0.1:{{ .tailnet.proxyPort }}" >&2
exec "$CADDY" run --config "$HOME/.config/caddy/Caddyfile" --adapter caddyfile
{{ end -}}
