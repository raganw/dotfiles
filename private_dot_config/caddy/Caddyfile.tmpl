{{- /* Rendered only on personal machines (not .is_work) listed in .chezmoidata/tailnet.toml. */ -}}
{{- $host := index .tailnet.hosts .chezmoi.hostname -}}
{{- if and (not .is_work) $host -}}
# Generated by chezmoi from .chezmoidata/tailnet.toml; edit that, not this.
# Started by launchd through ~/.local/bin/caddy-tailnet, which sets
# TAILNET_IP and CLOUDFLARE_API_TOKEN.
{
	email {{ .email }}
	# Only HTTPS, only on the tailnet address: no port 80 listener.
	auto_https disable_redirects
}

*.{{ .tailnet.domain }} {
	bind {$TAILNET_IP}
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# Check the challenge record on public DNS, not through MagicDNS.
		resolvers 1.1.1.1 1.0.0.1
	}
{{- range $host.services }}

	@{{ .name }} host {{ .name }}.{{ $.tailnet.domain }}
	handle @{{ .name }} {
		reverse_proxy 127.0.0.1:{{ .port }}
	}
{{- end }}

	# Any other name: close the connection.
	handle {
		abort
	}
}
{{ end -}}
