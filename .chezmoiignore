{{/*
  Repo-side helper scripts live under the source root (this repo IS the
  chezmoi source dir), so without this exclude chezmoi would try to apply
  them to ~/scripts. They are executed in place via {{ .chezmoi.sourceDir }}
  by the plist modify_ stubs and the apply hooks, never copied to the target.
*/}}
scripts
# Real files behind the ~/.claude symlinks (dot_claude/symlink_*)
claude
mise.toml

{{- if not .is_work }}
# Reserv-only Claude agents and skills (live in the dotfiles-work external)
.claude/agents/jira-fetcher.md
.claude/skills/claim-portal-browser-testing
.claude/skills/jira-lookup
.claude/skills/write-tdd
{{- end }}

{{- if or .is_work (not (hasKey .tailnet.hosts .chezmoi.hostname)) }}
# Tailnet proxy (Caddy for *.ts.spiffywidgets.com): personal machines listed
# in .chezmoidata/tailnet.toml only
.config/caddy
.local/bin/caddy-tailnet
Library/LaunchAgents/com.spiffywidgets.caddy-tailnet.plist
.chezmoiscripts/50-install-caddy.sh
.chezmoiscripts/51-restart-caddy-tailnet.sh
{{- end }}
