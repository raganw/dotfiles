{{- /*
vim:ft=toml.gotexttmpl
*/ -}}
{{- $email := promptStringOnce . "email" "Git email" "raganw@gmail.com" -}}
{{- $githubUser := promptStringOnce . "github_user" "GitHub username" "raganw" -}}
{{- $isWork := promptBoolOnce . "isWork" "Is this a work system?" -}}

[data]
  email = {{ $email | quote }}
  github_user = {{ $githubUser | quote }}
  is_work = {{ $isWork }}
  xdgCacheDir       = "{{ .chezmoi.homeDir }}/.cache"
  xdgConfigDir      = "{{ .chezmoi.homeDir }}/.config"
  xdgDataDir        = "{{ .chezmoi.homeDir }}/.local/share"
  xdgStateDir       = "{{ .chezmoi.homeDir }}/.local/state"

[diff]
  pager = "delta"
  format = "git"
  args = [ "--paging" , "never" ]
  exclude = [ "dirs", "externals", "scripts" ]

[merge]
  command = "nvim"
  args = [
    "-d",
    "{{ "{{" }} .Destination {{ "}}" }}",
    "{{ "{{" }} .Source {{ "}}" }}",
    "{{ "{{" }} .Target {{ "}}" }}",
  ]

[edit]
  command = "nvim"

[[textconv]]
  command = "plutil"
  args = ["-convert", "xml1", "-o", "-", "-"]
  pattern = "**/*.plist"

# Plist apply guards (macOS preference plists managed via modify_ stubs).
# The pre-hook computes which managed plists would change this apply (via
# `chezmoi status`) and refuses if any of those apps is running, so the app
# does not overwrite our writes when it quits. The post-hook nudges cfprefsd
# if anything changed and optionally relaunches quit apps.
#   DOTFILES_SKIP_PLIST_HOOKS=1      short-circuits both hooks (force-apply).
#   DOTFILES_RELAUNCH_AFTER_APPLY=1  reopens quit apps after a real apply.
[hooks.apply.pre]
  command = "{{ .chezmoi.sourceDir }}/scripts/chezmoi-hooks/guard-running-apps.sh"

[hooks.apply.post]
  command = "{{ .chezmoi.sourceDir }}/scripts/chezmoi-hooks/post-apply-plists.sh"
