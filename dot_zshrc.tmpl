{{- /*
vim:ft=zsh.gotexttmpl
*/ -}}
export ZSH="$HOME/.oh-my-zsh"
export ZSH_CUSTOM="$HOME/.zsh_custom"

plugins=(
    eza
    fzf
    git
    vi-mode
    zsh-autosuggestions
#   zsh-interactive-cd
)

source $ZSH/oh-my-zsh.sh

export EDITOR='nvim'
export PATH="$HOME/.local/bin:/Users/ragan/.lmstudio/bin:$HOME/.cache/.bun/bin:$PATH"
{{- if .is_work }}
[[ -f ~/.local/share/dotfiles-work/zsh/work.zsh ]] && source ~/.local/share/dotfiles-work/zsh/work.zsh
{{- end }}

if command -v starship >/dev/null 2>&1; then eval "$(command starship init zsh)"; fi
if command -v atuin >/dev/null 2>&1; then eval "$(command atuin init zsh)"; fi
if command -v mise >/dev/null 2>&1; then eval "$(command mise activate zsh)"; fi
if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

if [ -d "/Applications/Mud.app" ]; then alias mud='open -a "/Applications/Mud.app"'; fi


# dcg: warn if hook was silently removed from Claude Code settings
if command -v dcg &>/dev/null && command -v jq &>/dev/null; then
  if [ -f "$HOME/.claude/settings.json" ] && ! jq -e '.hooks.PreToolUse[]? | select(.hooks[]?.command | test("dcg$"))' "$HOME/.claude/settings.json" &>/dev/null; then
    printf '\033[1;33m[dcg] Hook missing from ~/.claude/settings.json — run: dcg install\033[0m\n'
  fi
fi

{{ if not .is_work -}}
# oMLX: CLI shim path begin
case ":$PATH:" in
  *":$HOME/.omlx/bin:"*) ;;
  *) export PATH="$HOME/.omlx/bin:$PATH" ;;
esac
# oMLX: CLI shim path end
{{ end -}}
