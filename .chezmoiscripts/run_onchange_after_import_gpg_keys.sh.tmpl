#!/bin/sh
{{- $filepath := join "/" (list .xdgConfigDir "git") -}}
{{- $keyfile := join "/" (list $filepath "github-web-flow.asc") -}}
{{- /* The key is an external, absent until the first apply fetches it; the hash then changes and this reruns */ -}}
# upstream sha256: {{ if stat $keyfile }}{{ include $keyfile | sha256sum }}{{ else }}pending{{ end }}

set -eu

for keyfile in {{ join "/" (list $filepath "*.asc") }}; do
  [ -f "$keyfile" ] || continue
  gpg --import "$keyfile" 2>/dev/null || true
  gpg --with-colons --import-options show-only --import <"$keyfile" 2>/dev/null | awk -F: '/^fpr:/{print $10":6:"}' | tail -1 | gpg --import-ownertrust 2>/dev/null || true
done

