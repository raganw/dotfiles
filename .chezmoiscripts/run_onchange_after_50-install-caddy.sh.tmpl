{{- if and (eq .chezmoi.os "darwin") (hasKey .tailnet.hosts .chezmoi.hostname) -}}
#!/bin/bash
# Installs Caddy {{ .tailnet.caddyVersion }} with caddy-dns/cloudflare {{ .tailnet.cloudflarePlugin }}
# to ~/.local/bin/caddy, for the tailnet proxy (.chezmoidata/tailnet.toml).
# Pinned, from Caddy's own build service, because Homebrew's Caddy tracks
# the newest release and has no DNS plugins. Reruns when a version changes.
# The download is checked for the version and the module before it replaces
# anything.
set -euo pipefail
want={{ .tailnet.caddyVersion | quote }}
plugin={{ .tailnet.cloudflarePlugin | quote }}
bin=$HOME/.local/bin/caddy

has_build() { # <binary>: right Caddy version and plugin version?
  "$1" version 2>/dev/null | grep -q "^$want " &&
    "$1" build-info 2>/dev/null | awk -v p="$plugin" '$2 == "github.com/caddy-dns/cloudflare" && $3 == p { f = 1 } END { exit !f }'
}

if [[ -x $bin ]] && has_build "$bin"; then
  echo "caddy: $want with caddy-dns/cloudflare $plugin already installed"
  exit 0
fi

mkdir -p "$HOME/.local/bin"
tmp=$(mktemp -d)
trap 'rm -r "$tmp"' EXIT
url="https://caddyserver.com/api/download?os=darwin&arch={{ .chezmoi.arch }}&p=github.com%2Fcaddy-dns%2Fcloudflare%40${plugin}&version=${want}"
echo "caddy: downloading $want with caddy-dns/cloudflare $plugin"
curl -fsSL --max-time 300 -o "$tmp/caddy" "$url"
chmod +x "$tmp/caddy"
if ! has_build "$tmp/caddy"; then
  echo "caddy: the download isn't $want with caddy-dns/cloudflare $plugin; not installed:" >&2
  "$tmp/caddy" version >&2 || true
  "$tmp/caddy" build-info 2>/dev/null | grep -i cloudflare >&2 || true
  exit 1
fi
mv "$tmp/caddy" "$bin"
echo "caddy: installed $("$bin" version)"
{{ end -}}
