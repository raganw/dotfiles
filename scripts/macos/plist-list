#!/usr/bin/env bash
#
# List the apps currently managed via modify_ plist stubs.
#
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$here/../.." && pwd)"
cd "$repo_root"

shopt -s nullglob
stubs=(private_Library/private_Preferences/modify_private_*.plist.tmpl)
if [ "${#stubs[@]}" -eq 0 ]; then
  echo "(none yet — scaffold one with: mise run plist:adopt <bundle-id>)"
  exit 0
fi

for s in "${stubs[@]}"; do
  id="${s##*/modify_private_}"
  id="${id%.plist.tmpl}"
  frag=".chezmoitemplates/$id.plist.tmpl"
  if [ -s "$frag" ]; then status="fragment ok"; else status="MISSING/EMPTY fragment"; fi
  printf '%-32s %s\n' "$id" "$status"
done
